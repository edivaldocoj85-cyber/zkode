# Copie para .env.local (dev) e configure na Vercel (Settings → Environment Variables).

# Contas de admin em JSON (email + senha por conta) — davi, junior, wendel:
# AUTH_USERS=[{"email":"davi@zkode.com.br","password":"..."},{"email":"junior@zkode.com.br","password":"..."},{"email":"wendel@zkode.com.br","password":"..."}]
AUTH_USERS=

# String longa e aleatória que assina o cookie de sessão (ex.: `openssl rand -hex 32`)
AUTH_SECRET=

# ===== Supabase (dados na nuvem) =====
# URL do projeto (Supabase → Project Settings → API).
SUPABASE_URL=
# SECRET key (sb_secret_...). Fica só no servidor (env). NUNCA no navegador nem no git.
SUPABASE_SECRET_KEY=
